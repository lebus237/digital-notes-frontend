{
  "name": "digitalnotes-frontend",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:admin": "pnpm --filter @digitalnotes/admin dev",
    "dev:app": "pnpm --filter @digitalnotes/app dev",
    "dev:contributor": "pnpm --filter @digitalnotes/contributor dev",
    "build:admin": "pnpm --filter @digitalnotes/admin build",
    "build:app": "pnpm --filter @digitalnotes/app build",
    "build:contributor": "pnpm --filter @digitalnotes/contributor build",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "translate:pull": "pnpm --filter @digitalnotes/admin translate:pull && pnpm --filter @digitalnotes/app translate:pull && pnpm --filter @digitalnotes/contributor translate:pull",
    "translate:push": "pnpm --filter@digitalnotes/admin translate:push && pnpm --filter @digitalnotes/app translate:push && pnpm --filter @digitalnotes/contributor translate:push",
    "translate:fill-missing": "node shared/i18n/scripts/deepl/translateMissingKeys.js",
    "translate:check-consistency": "node shared/i18n/scripts/checkTranslationConsistency.js"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-store": "^0.11.1",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "lodash-es": "^4.18.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@mantine/core": "^9.6.3",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-start": "^1.168.59",
    "@tolgee/cli": "^2.20.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sass": "^1.105.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  }
}
